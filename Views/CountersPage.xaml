<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Counter22.Models"
             x:Class="Counter22.Views.CountersPage"
             x:DataType="models:Counter"
             Title="Counter">
    <VerticalStackLayout
        Spacing="8"
        Margin="8"
    >
        <Label
             x:Name="CounterLbl"
             SemanticProperties.HeadingLevel="Level2"
        />
        <Editor
            x:Name="TextEditor"
            Text="{Binding Text}"
            HeightRequest="8"
            Placeholder="{Binding EditorPlaceholderText}"
        />
        <Grid
            ColumnDefinitions="*, *, *, *"
            ColumnSpacing="4"
        >
            <Button
                Grid.Column="0"
                Text="{Binding SaveButtonText}"
                Clicked="SaveButton_Clicked"
            />
            <Button
                Grid.Column="1"
                Text="{Binding DeleteButtonText}"
                Clicked="DeleteButton_Clicked"
            />
            <Button
               Grid.Column="2"
               x:Name="AdditionBtn"
               Text="{Binding AddButtonText}" 
               SemanticProperties.Hint="add a number to the counter"
               Clicked="OnAdditionClicked"
               />
            <Button
              Grid.Column="3"
              x:Name="SubstractionBtn"
              Text="{Binding SubstractButtonText}"
              SemanticProperties.Hint="substracts a number from the counter"
              Clicked="OnSubstractionClicked"
              />
        </Grid>
    </VerticalStackLayout>
</ContentPage>